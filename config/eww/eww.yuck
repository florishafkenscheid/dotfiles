; Includes
(include "./widgets/bar.yuck")
(include "./widgets/clock.yuck")
(include "./widgets/cpu_gpu.yuck")
(include "./widgets/memory.yuck")
(include "./widgets/mullvad.yuck")
(include "./widgets/mouse_battery.yuck")
(include "./widgets/now_playing.yuck")
(include "./widgets/system_badge.yuck")
(include "./widgets/volume_control.yuck")
(include "./widgets/workspaces.yuck")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Clock vars & polls
(defvar clock_is_hovered false)
(defpoll time_data :interval "1s" `date +'{"short":"%H:%M","seconds":":%S","day":%-d,"month":%-m,"year":%Y}'`)

; CPU && GPU vars & polls
; cpu_percent is a magic value, no need to get it ourselves
(defpoll gpu_percent :interval "2s" "cat /sys/bus/pci/devices/0000:03:00.0/gpu_busy_percent")
(defvar show_temps false) ; Make two instances of the temp popup, only show the one one the current monitor
(defpoll temps_string :interval "2s" "sensors -j | jq -r '\" \\(.[\"k10temp-pci-00c3\"].Tctl.temp1_input | round)    \\(.[\"amdgpu-pci-0300\"].junction.temp2_input | round) \"'")

; Memory usage
(defvar show_memory false)
(defvar memory_hovered false)
(defpoll hugepages_count :interval "5s" "cat /sys/kernel/mm/hugepages/hugepages-1048576kB/nr_hugepages")

; Mullvad status
(defpoll mullvad_status :interval "5s" "mullvad status -j | jq -r '.state'")

; Now playing (using playerctl, limited to tidal-hifi)
(defpoll now_playing_data :interval "2s" `scripts/get-now-playing.sh`)

; Volume control (Tidal PipeWire stream when active, otherwise default sink)
(defvar show_volume_slider false)
(defpoll volume_data :interval "1s" `scripts/get-volume.sh`)

; Lamzu Maya X battery
(defvar mouse_battery_hovered false)
(defpoll mouse_battery_data :interval "2m" `scripts/get-lamzu-battery.py`)

; Get workspaces and if they're active or not, per monitor
(deflisten workspace_labels_primary :initial "[]" `scripts/listen-workspace-labels.sh DP-2`)
(deflisten workspace_labels_secondary :initial "[]" `scripts/listen-workspace-labels.sh HDMI-A-1`)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Defining the top bars
(defwindow bar_primary
           :monitor '["<primary>", "DP-2", 0]'
           :geometry (geometry :x "0%"
                               :y "0%"
                               :width "100%"
                               :height "2.75%" ; 1080 * 0.0275 = ~30px
                               :anchor "top center"
                     )
           :stacking "fg"
           :exclusive "true"
           :focusable "ondemand"
           :namespace "bar"
           (bar :workspace_data workspace_labels_primary :calendar_window "calendar_primary")
)

(defwindow bar_secondary
           :monitor '["HDMI-A-1", 1]'
           :geometry (geometry :x "0%"
                               :y "0%"
                               :width "100%"
                               :height "2.75%" ; 1080 * 0.0275 = ~30px
                               :anchor "top center"
                     )
           :stacking "fg"
           :exclusive "true"
           :focusable "ondemand"
           :namespace "bar"
           (bar :workspace_data workspace_labels_secondary :calendar_window "calendar_secondary")
)

(defwindow calendar_primary
           :monitor '["<primary>", "DP-2", 0]'
           :geometry (geometry :x "0.6%"
                               :y "1%"
                               :anchor "top right"
                     )
           :stacking "fg"
           :exclusive "false"
           :focusable "false"
           :namespace "bar-calendar"
           (clock_calendar)
)

(defwindow calendar_secondary
           :monitor '["HDMI-A-1", 1]'
           :geometry (geometry :x "0.6%"
                               :y "1%"
                               :anchor "top right"
                     )
           :stacking "fg"
           :exclusive "false"
           :focusable "false"
           :namespace "bar-calendar"
           (clock_calendar)
)

(defwindow idle_overlay
           :monitor '["DP-2", 0]'
           :geometry (geometry :width "100%"
                               :height "100%"
                               :anchor "center"
                     )
           :stacking "overlay"
           :exclusive "false"
           :focusable "false"
           :namespace "idle-overlay"
           (image :class "idle-overlay"
                  :path "/home/blousy/Wallpapers/dune.png"
                  :image-width 3840
                  :image-height 2160
                  :preserve-aspect-ratio true)
)
