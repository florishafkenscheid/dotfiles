(defwidget bar [workspace_data]
  (box :class "bar-container"
    (centerbox :orientation "h"
      ; Left section - system stats
      (box
        :class "left-section"
        :halign "start"
        :orientation "h"
        :space-evenly false
        :spacing 16
        (system_badge)
        (cpu_gpu)
        (label :class "section-divider" :text "│")
        (memory)
      )

      ; Middle section - workspaces
      (box
        :class "middle-section"
        :halign "center"
        (workspaces :workspace_data workspace_data)
      )

      ; Right section - status indicators
      (box
        :class "right-section"
        :halign "end"
        :orientation "h"
        :space-evenly false
        :spacing 16
        (now_playing)
        (label :class "section-divider" :text "│")
        (mullvad)
        (label :class "section-divider" :text "│")
        (clock)
      )
    )
  )
)
