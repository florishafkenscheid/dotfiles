(defwidget memory []
  (eventbox
    :onhover "${EWW_CMD} update show_memory=true memory_hovered=true"
    :onhoverlost "${EWW_CMD} update show_memory=false memory_hovered=false"
    (box :class {hugepages_count > 0 ? "memory-widget widget hugepages-active" : "memory-widget widget"}
         :orientation "h"
         :valign "center"
         :space-evenly false
      (label :text " ${round(EWW_RAM.used_mem_perc, 0)}%")
      (revealer
        :reveal {memory_hovered}
        :transition "slideright"
        :duration "180ms"
        (label
          :class "memory-detail"
          :text "󰂻 ${hugepages_count}"
        )
      )
    )
  )
)
