(defwidget cpu_gpu []
  (eventbox
    :onhover "${EWW_CMD} update show_temps=true" 
    :onhoverlost "${EWW_CMD} update show_temps=false" 
    (box :class "cpu-gpu-widget widget"
         :orientation "h"
         :valign "center"
         :space-evenly false
         :spacing 12
      (label
        :class "cpu-usage"
        :text "󰍛 ${ceil(EWW_CPU.avg) ?: 0}%"
      )
      (label :text "  " :visible true)
      (label
        :class "gpu-usage"
        :text "${gpu_percent ?: 0}% 󰾲"
      )
    )
  )
)
