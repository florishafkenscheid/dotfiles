(defwidget volume_control []
  (eventbox
    :onscroll "json=$(scripts/set-volume.sh scroll {}); ${EWW_CMD} update volume_data=\"$json\""
    (box
      :class "volume-control widget"
      :orientation "h"
      :space-evenly false
      :spacing 10
      (button
        :class "volume-icon-button"
        :onclick "json=$(scripts/set-volume.sh toggle-mute); ${EWW_CMD} update volume_data=\"$json\""
        (label
          :class "volume-icon"
          :text "${volume_data.icon}"
        )
      )
      (eventbox
        :onhover "${EWW_CMD} update show_volume_slider=true"
        :onhoverlost "${EWW_CMD} update show_volume_slider=false"
        (box
          :class "volume-slider-hover"
          :orientation "h"
          :space-evenly false
          :spacing 10
          (label
            :class "volume-percent"
            :text "${volume_data.percent}%"
          )
          (label
            :class "volume-target"
            :text "${volume_data.target == "player" ? "T" : "S"}"
          )
          (revealer
            :reveal {show_volume_slider}
            :transition "slideright"
            :duration "180ms"
            (scale
              :class "volume-slider"
              :min 0
              :max 100
              :draw-value false
              :value {volume_data.percent}
              :onchange "json=$(scripts/set-volume.sh set {}); ${EWW_CMD} update volume_data=\"$json\""
            )
          )
        )
      )
    )
  )
)
