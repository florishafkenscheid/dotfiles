(defwidget now_playing []
  (eventbox
    :onhover "${EWW_CMD} update show_song=true" 
    :onhoverlost "${EWW_CMD} update show_song=false"
    
    (box 
      :class "island spotify"
      :orientation "h"
      :space-evenly false
      :spacing 14

      (label :text "♫")

      (revealer 
        :transition "slideright"
        :reveal show_song
        :duration "175ms"
        :class "spotify-revealer"

        (box 
          :orientation "h" 
          :space-evenly false
          :spacing 15
          :visible {strlength(now_playing_data) > 0}
          (label
            :class "song-title"
            :text "${now_playing_data.title}"
            :limit-width 35
            :truncate true
            :show-truncated false
          )
          (label
            :class "song-artist"
            :text " ${now_playing_data.artist}"
          )
        )
      )
    )
  )
)
