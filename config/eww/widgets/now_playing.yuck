(defwidget now_playing []
  (box
    :class "spotify widget"
    :orientation "v"
    :space-evenly false
    :spacing 2

    (box
      :class "now-playing-text"
      :orientation "v"
      :space-evenly false
      (label
        :class "song-title"
        :text "${now_playing_data.title}"
        :limit-width 30
        :truncate true
        :show-truncated false
      )
      (label
        :class "song-artist"
        :text "${now_playing_data.artist}"
        :visible {strlength(now_playing_data.artist) > 0}
        :limit-width 30
        :truncate true
        :show-truncated false
      )
    )
  )
)
