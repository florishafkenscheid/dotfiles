(defwidget workspaces [workspace_data]
  (box :class "workspaces-container" :orientation "h" :space-evenly false :spacing 6
    (for workspace in workspace_data
      (button
        :class "workspace-btn${workspace.active ? " active" : ""}"
        :onclick "hyprctl dispatch workspace ${workspace.id}"
        (box :orientation "h" :space-evenly false
          (label :text "${workspace.name}" :limit-width 2)

          ; App icons - Dune: only show icons on active workspace or if few workspaces
          (box
            :class "workspace-icons"
            :orientation "h"
            :space-evenly false
            :visible {workspace.icons != "[]"}
            (label :class "icon-label" :text {workspace.icons[0] ?: ""})
            (label :class "icon-label" :text {workspace.icons[1] ?: ""})
            (label :class "icon-label" :text {workspace.icons[2] ?: ""})
          )
        )
      )
    )
  )
)
