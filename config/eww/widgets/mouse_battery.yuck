(defwidget mouse_battery []
  (eventbox
    :onhover "${EWW_CMD} update mouse_battery_hovered=true"
    :onhoverlost "${EWW_CMD} update mouse_battery_hovered=false"
    :visible {mouse_battery_data.available}
    (box
      :class "mouse-battery ${mouse_battery_data.class} widget"
      :orientation "h"
      :valign "center"
      :space-evenly false
      :spacing 8
      (label
        :class "mouse-battery-icon"
        :text "${mouse_battery_data.icon}"
      )
      (revealer
        :reveal {mouse_battery_hovered || mouse_battery_data.percent <= 20}
        :transition "slideright"
        :duration "180ms"
        (label
          :class "mouse-battery-percent"
          :text "${mouse_battery_data.percent}%"
        )
      )
    )
  )
)
