(defwidget system_badge []
  (eventbox
    :onclick "hyprctl dispatch exec /home/blousy/.config/desktop/switch"
    (box
      :class "system-badge island"
      :orientation "h"
      :space-evenly false
      :spacing 8
      :valign "center"

      (label
        :class "logo-icon"
        :text ""
      )
    )
  )
)
