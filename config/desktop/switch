#!/bin/sh

# Keep every bar and keybinding pointed at one stable command. Sessions started
# by desktop/vt-session advertise the persistent mode; older/manual sessions
# retain the compositor handoff behavior.

set -u

script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

if [ "${BLOUSY_DESKTOP_MODE:-}" = "vt" ]; then
    exec "$script_dir/switch-vt" "$@"
fi

exec "$script_dir/switch-handoff" "$@"
