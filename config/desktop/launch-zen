#!/bin/sh

# Zen/Firefox profiles are single-writer. If the shared profile is open on the
# other persistent desktop, shut that process down cleanly, wait for it to
# release the profile, then relaunch Zen on the desktop that invoked us.

set -u

zen_binary="/opt/zen-browser-bin/zen-bin"
profile_root="${HOME:-/home/blousy}/.config/zen"
current_desktop="${BLOUSY_DESKTOP:-}"

notify() {
    if command -v notify-send >/dev/null 2>&1; then
        notify-send --app-name "Zen launcher" "$1" "$2"
    else
        printf '%s: %s\n' "$1" "$2" >&2
    fi
}

process_environment() {
    key="$1"
    pid="$2"
    tr '\0' '\n' <"/proc/${pid}/environ" 2>/dev/null |
        sed -n "s/^${key}=//p" |
        head -n 1
}

find_profile_owner() {
    for lock_file in "$profile_root"/*/lock; do
        [ -L "$lock_file" ] || continue

        lock_target="$(readlink "$lock_file" 2>/dev/null || :)"
        owner_pid="${lock_target##*:+}"
        case "$owner_pid" in
            "" | *[!0-9]*) continue ;;
        esac

        [ -r "/proc/${owner_pid}/environ" ] || continue
        [ "$(ps -o uid= -p "$owner_pid" 2>/dev/null | tr -d ' ')" = "$(id -u)" ] ||
            continue

        owner_executable="$(readlink -f "/proc/${owner_pid}/exe" 2>/dev/null || :)"
        [ "$owner_executable" = "$zen_binary" ] || continue

        printf '%s\n' "$owner_pid"
        return 0
    done

    return 1
}

if [ ! -x "$zen_binary" ]; then
    notify "Zen is unavailable" "The Zen browser executable is not installed."
    exit 127
fi

case "$current_desktop" in
    hyprland | niri) ;;
    *) exec "$zen_binary" "$@" ;;
esac

owner_pid="$(find_profile_owner || :)"
if [ -z "$owner_pid" ]; then
    exec "$zen_binary" "$@"
fi

owner_desktop="$(process_environment BLOUSY_DESKTOP "$owner_pid")"
case "$owner_desktop" in
    hyprland | niri) ;;
    *) exec "$zen_binary" "$@" ;;
esac

if [ "${BLOUSY_DESKTOP_MODE:-}" != "vt" ] ||
    [ "$owner_desktop" = "$current_desktop" ]; then
    exec "$zen_binary" "$@"
fi

# SIGTERM asks Zen to perform an orderly application shutdown. Never escalate
# to SIGKILL: if shutdown is blocked, leave the profile owner intact and tell
# the user instead of risking profile or session-state damage.
if ! kill -TERM "$owner_pid" 2>/dev/null; then
    notify "Could not move Zen" "The existing Zen process could not be closed."
    exit 1
fi

attempt=0
while kill -0 "$owner_pid" 2>/dev/null && [ "$attempt" -lt 100 ]; do
    sleep 0.1
    attempt=$((attempt + 1))
done

if kill -0 "$owner_pid" 2>/dev/null; then
    notify "Zen is still closing" \
        "The existing process did not exit after 10 seconds; migration was cancelled."
    exit 1
fi

exec "$zen_binary" "$@"
