#!/bin/sh

# Keep the authenticated greetd session alive while swapping compositors.
# A normal compositor exit returns to greetd; only an explicit switch request
# starts another compositor.

set -u

umask 077

# Both compositors inherit one Codex state root. This keeps the CLI, IDE
# extension, skills, profiles, and resumable sessions aligned without putting
# credentials or live state in the dotfiles repository.
shared_codex_state_dir="${CODEX_HOME:-/home/blousy/.codex}"
if [ -d "$shared_codex_state_dir" ]; then
    CODEX_HOME="$shared_codex_state_dir"
    export CODEX_HOME
else
    printf 'Codex state directory does not exist: %s\n' "$shared_codex_state_dir" >&2
fi

target="${1:-hyprland}"
runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
session_dir="${runtime_dir}/blousy-desktop-session"
current_file="${session_dir}/current"
next_file="${session_dir}/next"
supervisor_file="${session_dir}/supervisor"

is_desktop() {
    case "$1" in
        hyprland | niri) return 0 ;;
        *) return 1 ;;
    esac
}

desktop_available() {
    case "$1" in
        hyprland)
            command -v start-hyprland-quietly >/dev/null 2>&1
            ;;
        niri)
            command -v niri >/dev/null 2>&1 &&
                command -v qs >/dev/null 2>&1
            ;;
    esac
}

desktop_label() {
    case "$1" in
        hyprland) printf '%s\n' "Hyprland / Eww" ;;
        niri) printf '%s\n' "Niri / Quickshell" ;;
    esac
}

launch_desktop() {
    case "$1" in
        hyprland) start-hyprland-quietly ;;
        # Avoid niri-session here: its shutdown target tears down the entire
        # graphical session instead of returning control to this supervisor.
        niri) niri --session ;;
    esac
}

cleanup() {
    if [ -r "$supervisor_file" ] &&
        [ "$(sed -n '1p' "$supervisor_file")" = "$$" ]; then
        rm -f "$current_file" "$next_file" "$supervisor_file"
    fi
}

if ! is_desktop "$target"; then
    printf 'Unknown desktop: %s\n' "$target" >&2
    exit 2
fi

if ! mkdir -p "$session_dir"; then
    printf 'Could not create desktop session state in %s\n' "$session_dir" >&2
    exit 1
fi

if [ -r "$supervisor_file" ]; then
    old_pid="$(sed -n '1p' "$supervisor_file")"
    if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
        printf 'A desktop session supervisor is already running (PID %s).\n' "$old_pid" >&2
        exit 1
    fi
fi

printf '%s\n' "$$" >"$supervisor_file"
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

while :; do
    rm -f "$next_file"
    printf '%s\n' "$target" >"$current_file"

    if ! desktop_available "$target"; then
        printf '%s is not installed completely.\n' "$(desktop_label "$target")" >&2
        if [ "$target" = "niri" ]; then
            printf 'Install at least: niri quickshell\n' >&2
        fi
        sleep 3
        exit 127
    fi

    launch_desktop "$target"

    if [ ! -s "$next_file" ]; then
        break
    fi

    requested="$(sed -n '1p' "$next_file")"
    rm -f "$next_file"

    if ! is_desktop "$requested" || [ "$requested" = "$target" ]; then
        break
    fi

    target="$requested"
done
